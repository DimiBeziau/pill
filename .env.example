# Copier en `.env` puis renseigner. `.env` n'est jamais commité.

# Secret de signature des sessions (JWT), 32+ caractères aléatoires.
#   openssl rand -hex 32
SESSION_SECRET=

# Clés VAPID pour les notifications push (à générer une seule fois, à conserver :
# les changer invalide tous les abonnements existants).
#   npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# false = plus aucune création de compte (une fois les utilisatrices inscrites).
REGISTRATION_ENABLED=true

# Dev local uniquement (en Docker, la valeur est fixée par docker-compose.yml).
DATABASE_URL=file:./dev.db
